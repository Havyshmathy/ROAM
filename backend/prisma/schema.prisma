generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiaryVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips        Trip[]
  savedPlaces  SavedPlace[]
  diaryEntries DiaryEntry[]
}

model Place {
  id          String   @id @default(cuid())
  name        String
  country     String?
  region      String?
  description String?
  imageUrl    String?
  category    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  savedBy        SavedPlace[]
  itineraryStops ItineraryStop[]
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  title       String
  destination String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryStops ItineraryStop[]
  diaryEntries   DiaryEntry[]

  @@index([userId])
}

model ItineraryStop {
  id          String    @id @default(cuid())
  tripId      String
  placeId     String?
  title       String
  description String?
  visitDate   DateTime?
  dayNumber   Int       @default(1)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([tripId, dayNumber, position])
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
}

model DiaryEntry {
  id          String          @id @default(cuid())
  userId      String
  tripId      String?
  title       String
  content     String
  destination String?
  visibility  DiaryVisibility @default(PRIVATE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([visibility, createdAt])
}
